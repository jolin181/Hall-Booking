# ====================
# Backend Environment
# ====================

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/hallbooking
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT (must be at least 32 characters for HS256)
JWT_SECRET=replace_this_with_a_random_min_32_char_secret_key_here
JWT_EXPIRATION=86400000

# CORS — comma-separated list of allowed frontend origins (no wildcard in prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# JPA DDL auto ('update' for production, 'create-drop' only for dev)
DDL_AUTO=update

# ====================
# Frontend Environment
# ====================

# Base URL of the deployed backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# WebSocket URL (usually same as API base URL)
VITE_WS_URL=http://localhost:8080
